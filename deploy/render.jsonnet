// deploy/install.yaml, from the library in jsonnet/ with its defaults in
// namespace `agents`. `npm run render` writes it; `npm run render -- --check`
// fails if it is stale.
local operator = import 'jsonnet/main.libsonnet';

local cfg = operator.config { namespace: 'agents' };

local header(lines) =
  std.join('', [(if l == '' then '#' else '# ' + l) + '\n' for l in ['Generated by `npm run render` from deploy/jsonnet. Do not edit.', ''] + lines]);
// The header is a comment on the first document, not a document of its own.
local yaml(objects) =
  local stream = std.manifestYamlStream(objects, indent_array_in_object=false, c_document_end=false, quote_keys=false);
  assert std.startsWith(stream, '---\n');
  std.substr(stream, 4, std.length(stream) - 4);

{
  'install.yaml': header([
    'The operator, in one apply: namespace `agents`, the CustomResourceDefinitions',
    '(cluster-scoped), and the operator itself.',
    '',
    'The agent host StatefulSets, their connection-token Secrets and how people',
    'reach the hosts (Tailscale) are yours, next to it: see examples/.',
    '',
    'Another namespace, or a Role narrowed to the token Secrets: vendor',
    'deploy/jsonnet and set `config` there.',
  ]) + yaml(
    [{ apiVersion: 'v1', kind: 'Namespace', metadata: { name: cfg.namespace } }]
    + operator.crds
    + operator.objects(cfg)
  ),
}

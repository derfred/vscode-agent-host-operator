{
  "name": "vscode-agent-host-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Kubernetes operator that keeps VS Code agent host pods supplied with workspaces and scheduled automations",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "probe": "node scripts/probe.ts",
    "e2e": "node e2e/run.ts",
    "render": "node deploy/render.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3"
  }
}
